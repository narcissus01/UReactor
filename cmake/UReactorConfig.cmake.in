@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(yaml-cpp CONFIG)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    find_dependency(PkgConfig)
    pkg_check_modules(LIBDW REQUIRED IMPORTED_TARGET libdw)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UReactorTargets.cmake")
if(NOT TARGET Boost::context)
    add_library(Boost::context ALIAS UReactor::boost_context)
endif()
check_required_components(UReactor)
