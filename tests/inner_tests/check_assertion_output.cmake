execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
if(RELEASE_MODE)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Fallback test failed: ${result}\n${diagnostic}")
    endif()
    foreach(marker "formatting threw" "recursive assertion" "outer diagnostic")
        string(FIND "${diagnostic}" "${marker}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Missing diagnostic: ${marker}\n${diagnostic}")
        endif()
    endforeach()
else()
    if("${result}" STREQUAL "0" OR "${result}" STREQUAL "99")
        message(FATAL_ERROR "Debug assertion did not abort: ${result}")
    endif()
    if(NOT diagnostic MATCHES "debug diagnostic marker")
        message(FATAL_ERROR "Missing Debug message: ${result}\n${diagnostic}")
    endif()
endif()
if(NOT diagnostic MATCHES "Assertion failed:" OR NOT diagnostic MATCHES "Stacktrace:\n#0")
    message(FATAL_ERROR "Missing assertion/stack output:\n${diagnostic}")
endif()
